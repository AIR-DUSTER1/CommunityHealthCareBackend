# 环境变量示例
# 复制为 .env 或直接注入到运行环境（不要提交真实值）

# ---- 数据库 ----
DB_USERNAME=root
DB_PASSWORD=

# ---- Redis ----
REDIS_PASSWORD=

# ---- Sa-Token JWT（务必替换为随机字符串，建议 32 位以上）----
SA_TOKEN_JWT_SECRET=

# ---- Spring Boot Admin 监控中心 ----
SPRING_BOOT_ADMIN_USER=admin
SPRING_BOOT_ADMIN_PASSWORD=

# ---- SnailJob 调度中心 ----
SNAIL_JOB_TOKEN=

# ---- 邮件 ----
MAIL_FROM=no-reply@example.com
MAIL_USER=no-reply@example.com
MAIL_PASSWORD=

# ---- 阿里云短信 ----
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=

# ---- 三方登录 ----
MAXKEY_CLIENT_ID=
MAXKEY_CLIENT_SECRET=
GITEE_CLIENT_ID=
GITEE_CLIENT_SECRET=

# ---- 支付宝 ----
ALIPAY_APP_ID=
ALIPAY_APP_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=

# ---- 大模型（DashScope）----
DASHSCOPE_API_KEY=

# ---- 接口加解密（api-decrypt）----
# 使用 RSA 生成一对密钥，公钥配置到后端 publicKey，私钥配置到前端
API_DECRYPT_PUBLIC_KEY=
API_DECRYPT_PRIVATE_KEY=

# ---- 字段加密（mybatis-encryptor，默认关闭）----
MYBATIS_ENCRYPTOR_PASSWORD=
MYBATIS_ENCRYPTOR_PRIVATE_KEY=
MYBATIS_ENCRYPTOR_PUBLIC_KEY=

# ---- 消息推送 ----
UNIPUSH_PUSH_URL=

# ---- Docker 基础设施 ----
MYSQL_ROOT_PASSWORD=
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=
SA_PASSWORD=
POSTGRES_PASSWORD=
