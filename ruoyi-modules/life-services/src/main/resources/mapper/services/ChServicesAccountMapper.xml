<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.dromara.services.mapper.ChServicesAccountMapper">

    <select id="selectUserByUserId" resultType="String">
        select user_name from sys_user where user_id = #{userId}
    </select>
    <select id="selectAccountByUserId" resultType="integer">
        select count(*) from ch_services_account where user_id = #{userId}
    </select>
</mapper>
